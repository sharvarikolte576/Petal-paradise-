generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
	url      = env("DATABASE_URL")
}

enum Role {
	ADMIN
	CUSTOMER
}

enum PaymentStatus {
	PENDING
	PAID
	FAILED
	REFUNDED
}

enum OrderStatus {
	PENDING
	CONFIRMED
	PROCESSING
	PACKED
	OUT_FOR_DELIVERY
	DELIVERED
	CANCELLED
}

model User {
	id                    String                 @id @default(cuid())
	name                  String
	email                 String                 @unique
	passwordHash          String
	role                  Role                   @default(CUSTOMER)
	phone                 String?
	createdAt             DateTime               @default(now())
	updatedAt             DateTime               @updatedAt
	orders                Order[]
	inventoryTransactions InventoryTransaction[]
	statusHistory         OrderStatusHistory[]
	reviews               Review[]
}

model Category {
	id        String    @id @default(cuid())
	name      String
	slug      String    @unique
	description String?
	image     String?
	active    Boolean   @default(true)
	products  Product[]
	createdAt DateTime  @default(now())
	updatedAt DateTime  @updatedAt
}

model Product {
	id                String           @id @default(cuid())
	name              String
	slug              String           @unique
	description       String
	shortDescription  String?
	sku               String           @unique
	price             Int
	salePrice         Int?
	stock             Int              @default(0)
	lowStockThreshold Int              @default(5)
	weight            String?
	featured          Boolean          @default(false)
	bestSeller        Boolean          @default(false)
	active            Boolean          @default(true)
	categoryId        String
	category          Category         @relation(fields: [categoryId], references: [id])
	images            ProductImage[]
	variants          ProductVariant[]
	orderItems        OrderItem[]
	inventoryTransactions InventoryTransaction[]
	reviews           Review[]
	createdAt         DateTime         @default(now())
	updatedAt         DateTime         @updatedAt
}

model ProductImage {
	id        String  @id @default(cuid())
	productId String
	product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
	url       String
	altText   String?
	sortOrder Int     @default(0)
}

model ProductVariant {
	id        String  @id @default(cuid())
	productId String
	product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
	name      String
	sku       String  @unique
	price     Int
	stock     Int     @default(0)
	active    Boolean @default(true)
}

model Order {
	id            String   @id @default(cuid())
	orderNumber   String   @unique
	userId        String?
	user          User?    @relation(fields: [userId], references: [id])
	customerName  String
	email         String
	phone         String
	address       String
	city          String
	state         String
	postalCode    String
	country       String
	subtotal      Int
	discount      Int      @default(0)
	deliveryFee   Int
	tax           Int      @default(0)
	total         Int
	paymentMethod String
	paymentStatus PaymentStatus @default(PENDING)
	orderStatus   OrderStatus   @default(PENDING)
	notes         String?
	items         OrderItem[]
	payments      Payment[]
	statusHistory OrderStatusHistory[]
	createdAt     DateTime @default(now())
	updatedAt     DateTime @updatedAt
}

model OrderItem {
	id         String @id @default(cuid())
	orderId    String
	order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
	productId  String
	product    Product @relation(fields: [productId], references: [id])
	variantId  String?
	productName String
	sku        String
	quantity   Int
	price      Int
	subtotal   Int
}

model InventoryTransaction {
	id           String  @id @default(cuid())
	productId    String
	product      Product @relation(fields: [productId], references: [id])
	variantId    String?
	previousStock Int
	quantityChange Int
	newStock     Int
	reason       String
	userId       String
	user         User    @relation(fields: [userId], references: [id])
	createdAt    DateTime @default(now())
}

model Payment {
	id           String @id @default(cuid())
	orderId      String
	order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
	provider     String
	paymentId    String?
	amount       Int
	status       PaymentStatus
	transactionData Json?
	createdAt    DateTime @default(now())
	updatedAt    DateTime @updatedAt
}

model OrderStatusHistory {
	id        String @id @default(cuid())
	orderId   String
	order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
	fromStatus OrderStatus?
	toStatus  OrderStatus
	adminId   String
	admin     User   @relation(fields: [adminId], references: [id])
	createdAt DateTime @default(now())
}

model Review {
	id        String  @id @default(cuid())
	productId String
	product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
	userId    String
	user      User    @relation(fields: [userId], references: [id])
	rating    Int
	comment   String
	approved  Boolean @default(false)
	createdAt DateTime @default(now())
}

model StoreSetting {
	id        String @id @default(cuid())
	key       String @unique
	value     String
	updatedAt DateTime @updatedAt
}
